@page "/product/{slug}"
@inject OrchardCore.IOrchardHelper Orchard
<link rel="stylesheet" href="~/css/pages/product-detail.css" asp-append-version="true" />

@functions {
    [FromRoute]
    public string? Slug { get; set; }
}


@{
    var product = await Orchard.GetContentItemByAliasAsync($"alias:{Slug}", latest: true);

    if (product == null || product.ContentType != "Product")
    {
        Response.StatusCode = 404;
    }
}

@if (product == null)
{
    <div class="container text-center py-5"><h3>ไม่พบข้อมูลสินค้า</h3></div>
}
else{}

    @{
        var allImages = new List<string>();
        if (product.Content.Product?.Image?.Paths != null) {
            foreach(var p in product.Content.Product.Image.Paths) { allImages.Add((string)p); }
        }
        if (product.Content.Product?.MainImage?.Paths != null) {
            foreach(var p in product.Content.Product.MainImage.Paths) { allImages.Add((string)p); }
        }

        decimal? price = product.Content.Product?.Price?.Value;
        string? brand = product.Content.Product?.Brand?.Text;
        string? detail = product.Content.MarkdownBodyPart?.Markdown;
    }

    <section class="catalog-container container">
        <div class="row g-5">
            <div class="col-md-6">
                <div id="productCarousel" class="carousel slide catalog-image-box shadow-sm" data-bs-ride="carousel">
                    
                    @if (allImages.Count > 1) {
                        <div class="carousel-indicators">
                            @for (int i = 0; i < allImages.Count; i++) {
                                <button type="button" data-bs-target="#productCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
                            }
                        </div>
                    }

                    <div class="carousel-inner">
                        @if (allImages.Any()) {
                            @for (int i = 0; i < allImages.Count; i++) {
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <img src="@Orchard.AssetUrl(allImages[i])" class="d-block" alt="@product.DisplayText">
                                </div>
                            }
                        } else {
                            <div class="carousel-item active">
                                <div class="h-100 d-flex align-items-center justify-content-center text-muted">ไม่มีรูปภาพ</div>
                            </div>
                        }
                    </div>

                    @if (allImages.Count > 1) {
                        <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    }
                </div>
            </div>

            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(brand)) {
                    <span class="catalog-brand-label">@brand</span>
                }
                <h1 class="catalog-title">@product.DisplayText</h1>

                @if (price != null) {
                    <div class="catalog-price-tag">฿@price.Value.ToString("N0")</div>
                }

                @if (!string.IsNullOrEmpty(detail)) {
                    <div class="catalog-detail-section shadow-sm">
                        <h4>รายละเอียดสินค้า</h4>
                        <div class="markdown-content">@Html.Raw(detail)</div>
                    </div>
                }

                <div class="mt-4">
                    <a href="/product" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i> กลับหน้ารวมสินค้า
                    </a>
                </div>
            </div>
        </div>
    </section>
}