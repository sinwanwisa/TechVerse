@page
@model TechVerse.Cms.Pages.News.IndexModel
@using OrchardCore.ContentManagement
@using System.Linq
@inject OrchardCore.IOrchardHelper Orchard

@{
    // ดึงข้อมูลข่าวทั้งหมด
    var newsList = await Orchard.ContentQueryAsync("AllNewsList");
}
<link rel="stylesheet" href="~/css/pages/news-list.css" asp-append-version="true" />

<div class="container py-5">
    <h2 class="mb-5 border-bottom pb-3">News</h2>

    <div class="row g-4">
        @foreach (var item in newsList)
        {
            string title = item.DisplayText;
            string imagePath = item.Content.News?.Image?.Paths?[0] ?? "#";

            var sourceUrl = item.Content.News?.SourceUrl?.Url?.ToString();
            var sourceText = item.Content.News?.SourceUrl?.Text?.ToString() ?? "อ่านต้นฉบับ";
            var target = item.Content.News?.SourceUrl?.Target?.ToString() ?? "_blank";
            bool isActive = item.Content.News?.Active?.Value ?? false;

            var categoryIds = item.Content.News?.NewsCategory?.TermContentItemIds;

            string markdownContent = item.Content.MarkdownBodyPart?.Markdown?.ToString() ?? "#";

            string path = item.Content.AliasPart?.Alias ?? "#";
            var publishDate = item.PublishedUtc;

            <div class="col-12 mb-4">
                <div class="card shadow-sm">
                    <div class="row g-0">
                        <div class="col-md-4">
                            @if (!string.IsNullOrEmpty((string)imagePath))
                            {
                                <img src="@Orchard.AssetUrl((string)imagePath)" class="img-fluid rounded-start h-100" style="object-fit: cover;" alt="@title">
                            }
                            else
                            {
                                <div class="bg-light h-100 d-flex align-items-center justify-content-center">No Image</div>
                            }
                        </div>

                        <div class="col-md-8">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                   
                                    <small class="text-muted">Published: @publishDate?.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>

                                <h3 class="card-title h4 fw-bold">@title</h3>

                                @if (categoryIds != null)
                                {
                                    <div class="mb-2">
                                        @foreach (var catId in categoryIds)
                                        {
                                            <span class="badge border text-dark fw-light">ID: @catId</span>
                                        }
                                    </div>
                                }

                                <div class="card-text text-muted mb-3" style="font-size: 0.9rem;">
                                    <strong>Content Preview:</strong><br />
                                    @if (!string.IsNullOrEmpty(markdownContent))
                                    {
                                        @(markdownContent.Length > 200 ? markdownContent.Substring(0, 200) + "..." : markdownContent)
                                    }
                                </div>

                                <div class="d-flex gap-2 mt-auto">
                                    <a href="/news/@path" class="btn btn-primary btn-sm">อ่านข่าวในเว็บ</a>

                                    @if (!string.IsNullOrEmpty(sourceUrl))
                                    {
                                        <a href="@sourceUrl" target="@target" class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-box-arrow-up-right"></i> @sourceText
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>