@page
@model TechVerse.Cms.Pages.Home.IndexModel
@inject OrchardCore.IOrchardHelper Orchard
@using TechVerse.Cms.Pages.Widgets.Partials
@using OrchardCore
@using OrchardCore.ContentManagement
@using OrchardCore.ContentManagement.Metadata


@{
    // 1. ดึงข้อมูล Content Item จาก CMS (ใช้ Alias ที่คุณตั้งใน Admin)
    var widgetItem = await Orchard.GetContentItemByHandleAsync("alias:homepage-promotion");

    // 2. ตรวจสอบว่าดึงข้อมูลมาได้ไหม
    if (widgetItem != null)
    {
        // 3. เตรียม Model สำหรับส่งให้ Partial
        var promoWidgetModel = new _PromotionWidgetModel
        {
            ContentItem = widgetItem
        };

        // 4. เรียกใช้ Partial View
        @await Html.PartialAsync("/Pages/Widgets/Partials/_PromotionWidget.cshtml", promoWidgetModel)
    }
    else
    {
        <p>ไม่พบข้อมูล Widget (โปรดเช็ค Alias ใน Admin)</p>
    }
}