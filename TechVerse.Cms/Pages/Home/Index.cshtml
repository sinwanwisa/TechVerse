@page "/"
@model TechVerse.Cms.Pages.Home.IndexModel
@inject OrchardCore.IOrchardHelper Orchard
@using TechVerse.Cms.Pages.Widgets
@using TechVerse.Cms.Pages.Widgets.Partials
@using OrchardCore
@using OrchardCore.ContentManagement
@using OrchardCore.ContentManagement.Metadata


@{
    var Promotion= await Orchard.GetContentItemByHandleAsync("alias:homepage-promotion");
    var ProductHighlight = await Orchard.GetContentItemByHandleAsync("alias:homepage-product-highlight");
    var NewsActive = await Orchard.GetContentItemByHandleAsync("alias:homepage-news-active");
    var VideoReviewActive = await Orchard.GetContentItemByHandleAsync("alias:homepage-video-review-active");
    var SearchContent = await Orchard.GetContentItemByHandleAsync("alias:search-widget");
    @if (SearchContent != null)
    {
        <form method="get" action="/search">
            @await Html.PartialAsync(
            "/Pages/Widgets/Partials/SearchForm.cshtml",
        new SearchFormModel()
        )
</form>
}


    if (Promotion != null)
    {
     @await Html.PartialAsync("/Pages/Widgets/Partials/_PromotionWidget.cshtml", (ContentItem)Promotion)
    }
    if (ProductHighlight != null)
    {
        @await Html.PartialAsync("/Pages/Widgets/Partials/_ProductHighlight.cshtml", (ContentItem)ProductHighlight)
    }
    if (NewsActive != null)
    {
        @await Html.PartialAsync("/Pages/Widgets/Partials/_NewsWidget.cshtml", (ContentItem)NewsActive)
    }

    if (VideoReviewActive != null)
    {
        @await Html.PartialAsync("/Pages/Widgets/Partials/_VideoReviewWidget.cshtml", (ContentItem)VideoReviewActive)

    }
    else
    {
        <p>ไม่พบข้อมูล Widget (โปรดเช็ค Alias ใน Admin)</p>
    }
}