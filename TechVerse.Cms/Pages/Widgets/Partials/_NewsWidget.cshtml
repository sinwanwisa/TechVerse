@model TechVerse.Cms.Pages.Widgets.Partials._NewsWidgetModel
@using OrchardCore.ContentManagement
@inject OrchardCore.IOrchardHelper Orchard

@{
    var widget = Model?.ContentItem;
    var title = widget?.DisplayText ?? "News";
    var News = await Orchard.ContentQueryAsync("NewsActive");
}

<div class="news-widget container my-5">
    <h3 class="news-title mb-4">@title</h3>

    @if (News != null && News.Any())
    {
        <div class="news-list">
            @foreach (var item in News)
            {
                var imagePath = (string)item.Content.News?.Image?.Paths[0];
                var slug = (string)item.Content.AutoroutePart?.Path;

                <a href="~/@slug" class="news-item">
                    <!-- รูป -->
                    <div class="news-thumb">
                        @if (!string.IsNullOrEmpty(imagePath))
                        {
                            <img src="@Orchard.AssetUrl(imagePath)"
                                 alt="@item.DisplayText" />
                        }
                        else
                        {
                            <div class="no-image">No Image</div>
                        }
                </div>

                <!-- เนื้อหา -->
                <div class="news-content">
                    <h5 class="news-item-title">
                        @item.DisplayText
                    </h5>

                    <div class="news-meta">
                        @(item.PublishedUtc.HasValue
                                            ? item.PublishedUtc.Value.ToString("dd MMM yyyy")
                                            : "")
                        </div>

                        <span class="read-more">อ่านต่อ →</span>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light">ไม่พบข่าวสารในขณะนี้</div>
    }
</div>

<style>
    /* ---------- Widget ---------- */
    .news-widget {
        max-width: 1100px;
    }

    .news-title {
        font-weight: 700;
    }

    /* ---------- List ---------- */
    .news-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    /* ---------- Item ---------- */
    .news-item {
        display: flex;
        gap: 1rem;
        padding: 1rem;
        background: #fff;
        border-radius: 14px;
        text-decoration: none;
        color: inherit;
        box-shadow: 0 4px 14px rgba(0,0,0,.06);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .news-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 22px rgba(0,0,0,.1);
        }

    /* ---------- Image ---------- */
    .news-thumb {
        flex: 0 0 120px;
        height: 80px;
        border-radius: 10px;
        overflow: hidden;
        background: #f1f1f1;
    }

        .news-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .no-image {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .8rem;
        color: #999;
    }

    /* ---------- Content ---------- */
    .news-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .news-item-title {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: .35rem;
        line-height: 1.4;
    }

    .news-meta {
        font-size: .8rem;
        color: #888;
        margin-bottom: .4rem;
    }

    .read-more {
        font-size: .85rem;
        font-weight: 600;
        color: #0d6efd;
    }
</style>
