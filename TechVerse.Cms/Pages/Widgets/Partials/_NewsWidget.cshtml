@using OrchardCore
@using OrchardCore.ContentManagement
@using OrchardCore.ContentManagement.Metadata
@inject OrchardCore.IOrchardHelper Orchard
@functions {
    public class NewsWidgetModel
    {
        public ContentItem ContentItem { get; set; }
    }
}
@{
    var widget = Model?.ContentItem;
    var title = widget.Content.NewsWidget.Title.Text;
    var subtitle = widget.Content.NewsWidget.Subtitle?.Markdown;
    var maxItem = (int?)widget.Content.NewsWidget.MaxItem?.Value ?? 4;

    var newsIds = (widget?.Content["NewsWidget"]?["News"]?["ContentItemIds"]?.ToObject<string[]>()
                          as IEnumerable<string>) ?? Enumerable.Empty<string>();

    var newsItems = newsIds.Any()
         ? (await Orchard.GetContentItemsByIdAsync(newsIds)).Take(maxItem)
         : Enumerable.Empty<ContentItem>();
}
}
<link rel="stylesheet" href="~/css/widgets/news-widget.css" asp-append-version="true" />

<div class="news-widget container my-5">
    <h3 class="news-title mb-4">@title</h3>

    @if (newsItems != null && newsItems.Any())
    {
        <div class="news-list">
            @foreach (var item in newsItems)
            {
                var imagePaths = item.Content.News?.Image?.Paths;
                string imagePath = (imagePaths != null && imagePaths.Count > 0)
                ? (string)imagePaths[0]
                : null;

                var path = item.Content.AliasPart?.Alias ?? "#" ;

                <a href="/news/@path" class="news-item">
                <div class="news-thumb">
                        @if (!string.IsNullOrEmpty(imagePath))
                        {
                            <img src="@Orchard.AssetUrl(imagePath)"
                                 alt="@item.DisplayText" />
                        }
                        else
                        {
                            <div class="no-image bg-light text-center py-5">No Image</div>
                        }
                    </div>

                    <div class="news-content">
                        <h5 class="news-item-title">
                            @item.DisplayText
                        </h5>

                        <div class="news-meta text-muted small mb-2">
                            @if (item.PublishedUtc.HasValue)
                            {
                                <i class="far fa-calendar-alt"></i>
                                @item.PublishedUtc.Value.ToString("dd MMM yyyy")
                            }
                        </div>

                        <span class="read-more text-primary" >อ่านต่อ →</span>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light border">ไม่พบข่าวสารในขณะนี้</div>
    }

    <div class="text-center mt-4">
        <a href="/news" class="btn btn-outline-dark btn-sm px-4">ดูข่าวทั้งหมด</a>
    </div>
</div>
