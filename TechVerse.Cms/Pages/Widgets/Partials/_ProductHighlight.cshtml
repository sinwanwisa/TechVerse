@inject OrchardCore.IOrchardHelper Orchard
@using OrchardCore
@using OrchardCore.ContentManagement
@using OrchardCore.ContentManagement.Metadata
@functions {
    public class ProductHighlightModel
    {
        public ContentItem ContentItem { get; set; }
    }
}
@{
    var widget = Model?.ContentItem;
    var title = widget.Content.ProductHighlightWidget.Title.Text;
    var subtitle = widget.Content.ProductHighlightWidget.Subtitle?.Markdown;

    var productIds = (widget?.Content["ProductHighlightWidget"]?["Product"]?["ContentItemIds"]?.ToObject<string[]>()
                          as IEnumerable<string>) ?? Enumerable.Empty<string>();

    var productItems = await Orchard.GetContentItemsByIdAsync(productIds);
}
<link rel="stylesheet" href="~/css/widgets/product-highlight.css" asp-append-version="true" />

<div class="product-highlight-widget container my-5">
    <div class="section-header text-center mb-4">
        <h3 class="widget-title">@title</h3>
        @if (!string.IsNullOrEmpty(subtitle))
        {
            <p class="widget-subtitle">@subtitle</p>
        }
    </div>

    @if (productItems.Any())
    {
        <div class="product-bg">
            <div class="product-scroll-container">
                <button class="scroll-btn left" onclick="scrollProducts(-1)">‹</button>

                <div class="product-scroll-wrapper" id="productScrollWrapper">
                    <div class="product-scroll">
                        @foreach (var product in productItems)
                        {
                            var imagePath = product.Content.Product?.MainImage?.Paths[0]
                            ?? product.Content.ProductHighlightWidget?.MainImage?.Paths[0];
                            var price = product.Content.Product?.Price?.Value;
                            var path = product.Content.AliasPart?.Alias ?? "#";

                            <div class="product-card">
                                <div class="product-image">
                                    @if (!string.IsNullOrEmpty((string)imagePath))
                                    {
                                        <img src="@Orchard.AssetUrl((string)imagePath)" alt="@product.DisplayText" />
                                    }
                                    else
                                    {
                                        <div class="no-image">ไม่มีรูปภาพ</div>
                                    }
                                </div>

                                <div class="product-info">
                                    <h5 class="product-title">@product.DisplayText</h5>
                                    @if (price != null)
                                    {
                                        <div class="product-price">
                                            @(((double)price).ToString("N0")) บาท
                                        </div>
                                    }
                                    <a href="/product/@path"
                                       class="btn btn-outline-dark btn-sm mt-3 w-100">
                                        ดูรายละเอียด
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <button class="scroll-btn right" onclick="scrollProducts(1)">›</button>
            </div>
        </div>
    }
</div>
<script src="~/js/widgets/product-highlight.js" asp-append-version="true"></script>

