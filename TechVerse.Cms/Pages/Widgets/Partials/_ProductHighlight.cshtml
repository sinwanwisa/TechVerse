@model TechVerse.Cms.Pages.Widgets.Partials._ProductHighlightModel
@using OrchardCore.ContentManagement
@inject OrchardCore.IOrchardHelper Orchard

@{
    var widget = Model?.ContentItem;
    var title = widget?.DisplayText ?? "Product Highlight";
    var products = await Orchard.ContentQueryAsync("ProductHighlight");
}

<div class="product-highlight-container">
    <h3 class="mb-4">@title</h3>

    @if (products != null && products.Any())
    {
        <div class="row">
            @foreach (var product in products)
            {
                var imagePath = (string)product.Content.Product?.Image?.Paths[0];
                var price = product.Content.Product?.Price?.Value;

                <div class="col-md-3 mb-4">
                    <div class="product-card shadow-sm p-3 border rounded h-100">

                        @if (!string.IsNullOrEmpty(imagePath))
                        {
                            <div class="product-image mb-2">
                                <img src="@Orchard.AssetUrl(imagePath)" alt="@product.DisplayText"
                                     class="img-fluid rounded"
                                     style="width:100%; height:200px; object-fit:contain;" />
                            </div>
                        }
                        else
                        {
                            <div class="no-image bg-light d-flex align-items-center justify-content-center rounded mb-2" style="height:200px;">
                                <span class="text-muted">ไม่มีรูปภาพ</span>
                            </div>
                        }

                        <h5 class="mt-2" style="font-size: 1rem; font-weight: bold;">@product.DisplayText</h5>

                        @if (price != null)
                        {
                            <p class="text-primary fw-bold">
                                @(((double)price).ToString("N0")) บาท
                            </p>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            ไม่พบสินค้าที่ติ๊ก Highlight (Query: ProductHighlight)
        </div>
    }
</div>