@inject OrchardCore.IOrchardHelper Orchard
@using OrchardCore
@using OrchardCore.ContentManagement
@using OrchardCore.ContentManagement.Metadata 
@addTagHelper *, OrchardCore.DynamicCache

<dynamic-cache cache-id="@($"video-review-{Model.ContentItem.ContentItemId}")"
               cache-dependency="
        contentitemid:@Model.ContentItem.ContentItemId;
        contenttype:VideoReview"
               fixed-duration="03:00:00">


    @{
        var widget = Model.ContentItem as ContentItem;
        var content = widget?.Content.VideoReviewWidget;
        var title = content?.Title.Text;
        var subtitle = content?.Subtitle?.Markdown;
        var maxItem = (int?)content?.MaxItem?.Value ?? 6;

        string[] videoReviewIds = content?.VideoReview?.ContentItemIds?.ToObject<string[]>() ?? Array.Empty<string>();

        var videoReviewItems = videoReviewIds.Any()
        ? (await Orchard.GetContentItemsByIdAsync(videoReviewIds)).Take(maxItem)
        : Enumerable.Empty<ContentItem>();
    }

    <section class="video-review-section container my-5">
        <div class="section-header mb-4 text-center">
            <h2 class="section-title">@title</h2>
            <p class="section-subtitle">@(subtitle ?? "รีวิววิดีโอ")</p>
        </div>

        @if (videoReviewItems.Any())
        {
            <div class="row g-4">
                @foreach (var item in videoReviewItems)
                {
                    var embedUrl = item.Content.VideoReview.YouTubeLink.EmbeddedAddress;
                    <div class="col-lg-4 col-md-6">
                        <div class="video-card h-100">
                            <div class="ratio ratio-16x9">
                                <iframe src="@embedUrl" title="@item.DisplayText" allowfullscreen></iframe>
                            </div>
                            <div class="video-card-body mt-2">
                                <h5 class="video-title">@item.DisplayText</h5>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </section>

</dynamic-cache>
