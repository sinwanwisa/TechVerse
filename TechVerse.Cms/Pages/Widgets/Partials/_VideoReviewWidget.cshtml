@model TechVerse.Cms.Pages.Widgets.Partials._VideoReviewWidgetModel
@inject OrchardCore.IOrchardHelper Orchard
@using OrchardCore.ContentManagement

@{
    var widget = Model?.ContentItem;
    var title = widget?.DisplayText ?? "Video Reviews";
    var Reviews = await Orchard.ContentQueryAsync("VideoReviewActive");
}
<link rel="stylesheet" href="~/css/widgets/video-review.css" asp-append-version="true" />

<section class="video-review-section container my-5">
    <div class="section-header mb-4 text-center">
        <h2 class="section-title">@title</h2>
        <p class="section-subtitle">รีวิวสินค้าและเทคโนโลยีจากวิดีโอ</p>
    </div>

    @if (Reviews != null && Reviews.Any())
    {
        <div class="row g-4">
            @foreach (var item in Reviews)
            {
                var videoPart = item.Content.VideoReview;
                var youtubeLink = videoPart?.YouTubeLink;

                <div class="col-lg-4 col-md-6">
                    <div class="video-card h-100">
                        @if (youtubeLink != null && !string.IsNullOrEmpty(youtubeLink.EmbeddedAddress?.ToString()))
                        {
                            <div class="video-wrapper">
                                <iframe src="@youtubeLink.EmbeddedAddress"
                                        title="@item.DisplayText"
                                        frameborder="0"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                        allowfullscreen>
                                </iframe>
                            </div>
                        }

                        <div class="video-card-body">
                            <h5 class="video-title">@item.DisplayText</h5>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light text-center">
            ยังไม่มีวิดีโอรีวิว
        </div>
    }
</section>
