@model TechVerse.Cms.Pages.Widgets.Partials._VideoReviewWidgetModel
@inject OrchardCore.IOrchardHelper Orchard
@using OrchardCore.ContentManagement

@{
    var widget = Model?.ContentItem;
    var title = widget?.DisplayText ?? "Video Reviews";
    var Reviews = await Orchard.ContentQueryAsync("VideoReviewActive");
}

<section class="video-review-section container my-5">
    <div class="section-header mb-4 text-center">
        <h2 class="section-title">@title</h2>
        <p class="section-subtitle">รีวิวสินค้าและเทคโนโลยีจากวิดีโอ</p>
    </div>

    @if (Reviews != null && Reviews.Any())
    {
        <div class="row g-4">
            @foreach (var item in Reviews)
            {
                var videoPart = item.Content.VideoReview;
                var youtubeLink = videoPart?.YouTubeLink;

                <div class="col-lg-4 col-md-6">
                    <div class="video-card h-100">
                        @if (youtubeLink != null && !string.IsNullOrEmpty(youtubeLink.EmbeddedAddress?.ToString()))
                        {
                            <div class="video-wrapper">
                                <iframe src="@youtubeLink.EmbeddedAddress"
                                        title="@item.DisplayText"
                                        frameborder="0"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                        allowfullscreen>
                                </iframe>
                            </div>
                        }

                        <div class="video-card-body">
                            <h5 class="video-title">@item.DisplayText</h5>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light text-center">
            ยังไม่มีวิดีโอรีวิว
        </div>
    }
</section>

<style>
    /* ---------- Section ---------- */
    .video-review-section {
        max-width: 1200px;
    }

    .section-title {
        font-weight: 800;
    }

    .section-subtitle {
        color: #777;
        font-size: .95rem;
    }

    /* ---------- Card ---------- */
    .video-card {
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(0,0,0,.08);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .video-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 36px rgba(0,0,0,.12);
        }

    /* ---------- Video ---------- */
    .video-wrapper {
        position: relative;
        padding-top: 56.25%;
        background: #000;
    }

        .video-wrapper iframe {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: none;
        }

    /* ---------- Body ---------- */
    .video-card-body {
        padding: 1rem 1.2rem;
    }

    .video-title {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.45;
        margin: 0;
    }


 
</style>
