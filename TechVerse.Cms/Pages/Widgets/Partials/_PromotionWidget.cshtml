@inject OrchardCore.IOrchardHelper Orchard
@using OrchardCore
@using OrchardCore.ContentManagement
@using OrchardCore.ContentManagement.Metadata
@functions {
    public class PromotionWidgetViewModel
    {
        public ContentItem ContentItem { get; set; }
    }
}
@{
    var widget = Model?.ContentItem;
    var promotionIds = (widget?.Content["PromotionWidget"]?["SelectedPromotion"]?["ContentItemIds"]?.ToObject<string[]>() as IEnumerable<string>)
                       ?? Enumerable.Empty<string>();
    var promoItems = await Orchard.GetContentItemsByIdAsync(promotionIds);
}

<link rel="stylesheet" href="~/css/widgets/promotion-banner.css" asp-append-version="true" />

<div class="promotion-banner-container position-relative">
    @if (promoItems.Any())
    {
        <div class="banner-slider overflow-hidden position-relative" style="max-width:1920px; margin:0 auto;">
            <div class="banner-track d-flex transition-slide" id="bannerTrack" data-total="@promoItems.Count()">

                @foreach (var promoItem in promoItems)
                {
                    var imagePaths = promoItem.Content.Promotion?.Image?.Paths
                    ?? promoItem.Content.PromotionWidget?.Image?.Paths;

                    <div class="banner-item">
                        <div class="banner-image">
                            @if (imagePaths != null && imagePaths.Count > 0)
                            {
                                <img src="@Orchard.AssetUrl((string)imagePaths[0])"
                                     alt="@promoItem.DisplayText" />
                            }
                            else
                            {
                                <div class="no-image bg-light text-center" style="height: 600px; display:flex; align-items:center; justify-content:center;">
                                    <span class="text-muted">ไม่มีรูปภาพ</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <button class="banner-prev position-absolute top-50 start-0 translate-middle-y btn btn-dark btn-sm" onclick="slideBanner(-1)">❮</button>
            <button class="banner-next position-absolute top-50 end-0 translate-middle-y btn btn-dark btn-sm" onclick="slideBanner(1)">❯</button>
        </div>
    }
</div>
<script src="~/js/widgets/promotion-banner.js" asp-append-version="true"></script>

