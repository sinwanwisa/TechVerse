@page "/article/{slug}"
@inject OrchardCore.IOrchardHelper Orchard
@addTagHelper *, OrchardCore.DynamicCache


@functions {
    [FromRoute]
    public string? Slug { get; set; }
}
@{
    var article = await Orchard.GetContentItemByAliasAsync($"alias:{Slug}", latest: true);

    if (article == null || article.ContentType != "Article")
    {
        Response.StatusCode = 404;
        return;
    }

  

    var title = article.DisplayText;
    var mainImage = article.Content.Article?.MainImage?.Paths?[0] ?? "#";
    var summary = article.Content.Article?.Summary?.Markdown?.ToString();

    var sections = article.Content.BagPart?.ContentItems as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<link rel="stylesheet" href="~/css/pages/article-detail.css" asp-append-version="true" />

<div class="container mt-5 mb-5">
    <dynamic-cache cache-id="@($"article-detail-{article.ContentItemId}")"
                   dependencies="@($"contentitemid:{article.ContentItemId}")"
                   expires-after="@TimeSpan.FromHours(1)">

    <article class="article-detail-wrapper">
        <header class="article-header mb-4">
            <h1 class="display-4 fw-bold">@title</h1>
            <p class="text-muted">เผยแพร่เมื่อ: @article.CreatedUtc?.ToString("dd MMMM yyyy")</p>

            @if (!string.IsNullOrEmpty((string)mainImage))
            {
                <div class="main-image-container mb-4">
                    <img src="@Orchard.AssetUrl((string)mainImage)" class="img-fluid rounded shadow-sm" alt="@title" />
                </div>
            }
        </header>

        @if (!string.IsNullOrEmpty(summary))
        {
            <div class="article-summary-box p-4 bg-light rounded mb-5 italic">
                @Html.Raw(summary)
            </div>
        }

        @* วนลูปแสดงเนื้อหาแต่ละ Section จาก BagPart *@
        <div class="article-sections">
            @foreach (var section in sections)
            {
                var subHeading = section.SectionArticle?.SubHeading?.Text?.ToString() ?? "#";
                var subBody = section.SectionArticle?.SubBody?.Markdown?.ToString() ?? "#"; ;
                var subImage = section.SectionArticle?.SubImage?.Paths?[0]; ;

                <section class="mb-5">
                    @if (!string.IsNullOrEmpty(subHeading))
                    {
                        <h2 class="h3 mb-3">@subHeading</h2>
                    }

                    @if (!string.IsNullOrEmpty((string)subImage))
                    {
                        <div class="sub-image mb-3">
                            <img src="@Orchard.AssetUrl((string)subImage)" class="img-fluid rounded" alt="@subHeading" />
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(subBody))
                    {
                        <div class="section-content lead-text">
                            @* ใช้ Html.Raw เพื่อ Render Markdown/HTML *@
                            @Html.Raw(subBody)
                        </div>
                    }
                </section>
            }
        </div>
    </article>
    </dynamic-cache>
</div>
