@page
@model TechVerse.Cms.Pages.Search.IndexModel

<div class="container my-5">
    <div class="row">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <i class="fa fa-filter"></i> ตัวกรอง
                </div>
                <div class="card-body">
                    <form method="get">
                        @* เก็บค่าค้นหาไว้เมื่อกด Filter *@
                        <input type="hidden" name="Terms" value="@Model.Terms" />

                        <h6>ประเภทเนื้อหา</h6>
                        @foreach (var type in Model.AvailableTypes)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox"
                                       name="SelectedTypes"
                                       value="@type.Name" @* ส่ง Name (Technical Name) ไปยัง Server *@
                                       id="type-@type.Name"
                                       @(Model.SelectedTypes.Contains(type.Name) ? "checked" : "")>
                                <label class="form-check-label" for="type-@type.Name">
                                    @type.DisplayName @* แสดงชื่อที่เป็นมิตรกับผู้ใช้ *@
                                </label>
                            </div>
                        }

                        <button type="submit" class="btn btn-sm btn-primary w-100 mt-3">
                            นำไปใช้
                        </button>

                        @if (Model.SelectedTypes.Any())
                        {
                            <a asp-page="./Index" asp-route-Terms="@Model.Terms" class="btn btn-sm btn-link w-100 mt-1 text-decoration-none">ล้างตัวกรอง</a>
                        }
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <h2>ผลการค้นหา: "@Model.Terms"</h2>
            <p class="text-muted">พบ @Model.Results.Count() รายการ</p>
            <hr />

            @if (Model.Results.Any())
            {
                @foreach (var item in Model.Results)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title mb-1">
                                <a href="/Contents/ContentItems/@item.ContentItemId" class="text-decoration-none">
                                    @item.DisplayText
                                </a>
                            </h5>
                            <div class="d-flex align-items-center">
                                <span class="badge bg-secondary me-2">@item.ContentType</span>
                                <small class="text-muted">ID: @item.ContentItemId</small>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-light border shadow-sm text-center py-5">
                    <i class="fa fa-search fa-3x mb-3 text-muted"></i>
                    <p>ไม่พบข้อมูลที่ตรงตามเงื่อนไขที่คุณค้นหา</p>
                </div>
            }
        </div>
    </div>
</div>
