@page
@using TechVerse.Cms.Pages.Widgets.Partials
@using OrchardCore.ContentManagement
@model TechVerse.Cms.Pages.Search.IndexModel

@using OrchardCore.Alias.Models
@{
    var searchFormModel = new SearchFormModel
    {
        Terms = Model.Terms
    };
}

<form method="get" action="/search">
    @await Html.PartialAsync("/Pages/Widgets/Partials/SearchForm.cshtml", searchFormModel)

    <div class="container my-5">
        <div class="row">
            <div class="col-md-3">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-primary text-white">
                        <i class="fa fa-filter"></i> ตัวกรอง
                    </div>
                    <div class="card-body">
                        <h6 class="fw-bold">ประเภทเนื้อหา</h6>
                        @foreach (var type in Model.AvailableTypes)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="SelectedTypes"
                                       value="@type.Name"
                                       id="type-@type.Name"
                                       onchange="this.form.submit()"
                                       @(Model.SelectedTypes.Contains(type.Name) ? "checked" : "") />
                                <label class="form-check-label" for="type-@type.Name">
                                    @type.DisplayName
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-9">
                <h2 class="h4">ผลการค้นหา: <span class="text-primary">"@Model.Terms"</span></h2>
                <p class="text-muted small">พบ @Model.Results.Count() รายการ</p>
                <hr />

                @if (Model.Results.Any())
                {
                    @foreach (var item in Model.Results)
                    {
                        var aliasPart = item.As<AliasPart>();
                        string alias = aliasPart?.Alias;
                        string contentType = item.ContentType.ToLower();
                        var linkUrl = !string.IsNullOrEmpty(alias)
                        ? $"/{contentType}/{alias}"
                        : $"/Contents/ContentItems/{item.ContentItemId}";
                        string imagePath = item.Content.News?.Image?.Paths?[0];

                        <div class="card mb-3 shadow-sm border-0">
                            <div class="row g-0">
                                @if (!string.IsNullOrEmpty(imagePath))
                                {
                                    <div class="col-md-3">
                                        <img src="/media/@imagePath" class="img-fluid rounded-start h-100" style="object-fit: cover;" alt="@item.DisplayText">
                                    </div>
                                }
                                <div class="@(string.IsNullOrEmpty(imagePath) ? "col-12" : "col-md-9")">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <a href="@linkUrl" class="text-decoration-none text-dark fw-bold">
                                                @item.DisplayText
                                            </a>
                                        </h5>
                                        <div class="mb-2">
                                            <span class="badge bg-secondary">@item.ContentType</span>
                                        </div>

                                        @if (item.Content.MarkdownBodyPart != null)
                                        {
                                            <p class="card-text text-muted small">
                                                @{
                                                    string rawText = item.Content.MarkdownBodyPart.Markdown?.ToString() ?? "";
                                                    var preview = rawText.Length > 180 ? rawText.Substring(0, 180) + "..." : rawText;
                                                }
                                                @preview
                                            </p>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else if (!string.IsNullOrEmpty(Model.Terms))
                {
                    <div class="alert alert-light border text-center py-5">
                        <i class="fa fa-search fa-2x mb-3 text-muted"></i>
                        <p>ไม่พบข้อมูลที่ตรงกับการค้นหา</p>
                    </div>
                }
            </div>
        </div>
    </div>
</form>